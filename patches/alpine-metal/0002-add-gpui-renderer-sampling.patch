+#[cfg(any(test, feature = "test-support"))]
+fn profiled_gpu_execution_ns(command_buffer: &metal::CommandBufferRef) -> Option<u64> {
+    let started: f64 = unsafe { msg_send![command_buffer, GPUStartTime] };
+    let completed: f64 = unsafe { msg_send![command_buffer, GPUEndTime] };
+    let elapsed = (completed - started) * 1_000_000_000.0;
+    if started.is_finite()
+        && completed.is_finite()
+        && completed > started
+        && elapsed.is_finite()
+        && elapsed > 0.0
+        && elapsed <= u64::MAX as f64
+    {
+        Some(elapsed.round() as u64)
+    } else {
+        None
+    }
+}
