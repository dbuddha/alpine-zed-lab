+            ));
+        }
+    };
+    if !source
+        .lines()
+        .any(|line| line == "schema = \"alpine-scene-trace/v2\"")
+    {
+        return Err("GPUI renderer sampling requires alpine-scene-trace/v2".to_owned());
+    }
+    v2::benchmark_source(&source, output_path, warmup_iterations, sample_count)
