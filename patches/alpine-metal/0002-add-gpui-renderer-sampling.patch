+pub(super) fn benchmark_source(
+    source: &str,
+    output_path: &Path,
+    warmup_iterations: u64,
+    sample_count: u64,
+) -> Result<BenchmarkReport, String> {
+    if cfg!(feature = "runtime-shaders") {
+        return Err("GPUI renderer sampling requires pinned offline Metal shaders".to_owned());
+    }
+    validate_benchmark_counts(warmup_iterations, sample_count)?;
+    match fs::symlink_metadata(output_path) {
+        Err(error) if error.kind() == ErrorKind::NotFound => {}
+        Ok(_) => {
+            return Err(format!(
+                "GPUI renderer benchmark output already exists: {}",
+                output_path.display()
+            ));
+        }
+        Err(error) => {
+            return Err(format!(
+                "cannot inspect GPUI renderer benchmark output {}: {error}",
+                output_path.display()
+            ));
+        }
+    }
+
+    let prepared = decode(source)?;
+    let mut renderer = match gpui_platform::current_headless_renderer() {
+        Some(renderer) => renderer,
+        None => return Err("pinned GPUI headless Metal renderer is unavailable".to_owned()),
+    };
+    let (scene, adaptation) = prepared.build_scene(renderer.sprite_atlas().as_ref())?;
+    let clear = prepared.clear_color();
+    let admitted = match renderer.render_scene_to_image_with_clear(&scene, prepared.size(), clear) {
+        Ok(image) => image.into_raw(),
+        Err(error) => return Err(format!("pinned GPUI Metal readback failed: {error:#}")),
+    };
+
+    for _ in 0..warmup_iterations {
+        let image = match renderer.render_scene_to_image_with_clear(&scene, prepared.size(), clear)
+        {
+            Ok(image) => image.into_raw(),
+            Err(error) => return Err(format!("pinned GPUI Metal readback failed: {error:#}")),
+        };
+        if image != admitted {
+            return Err("GPUI renderer benchmark image changed during warmup".to_owned());
+        }
+    }
+
+    let capacity = match usize::try_from(sample_count) {
+        Ok(capacity) => capacity,
+        Err(_) => return Err("GPUI renderer benchmark sample count exceeds usize".to_owned()),
+    };
+    let mut samples = Vec::with_capacity(capacity);
+    for _ in 0..sample_count {
+        let started = std::time::Instant::now();
+        let image = match renderer.render_scene_to_image_with_clear(&scene, prepared.size(), clear)
+        {
+            Ok(image) => image,
+            Err(error) => return Err(format!("pinned GPUI Metal readback failed: {error:#}")),
+        };
+        let elapsed = elapsed_benchmark_ns(started)?;
+        if image.into_raw() != admitted {
+            return Err("GPUI renderer benchmark image changed during measurement".to_owned());
+        }
+        samples.push(elapsed);
+    }
+
+    let csv = render_benchmark_samples(&samples)?;
+    publish_benchmark_samples(output_path, csv.as_bytes())?;
+    Ok(BenchmarkReport {
+        identity: prepared.identity,
+        adaptation,
+        warmup_iterations,
+        sample_count,
+    })
+}
+
+pub(super) fn profile_source(
+    source: &str,
+    output_path: &Path,
+    warmup_iterations: u64,
+    sample_count: u64,
+) -> Result<ProfileReport, String> {
+    if cfg!(feature = "runtime-shaders") {
+        return Err("GPUI renderer profiling requires pinned offline Metal shaders".to_owned());
+    }
+    validate_benchmark_counts(warmup_iterations, sample_count)?;
+    ensure_new_sample_output(output_path, "profile")?;
+
+    let prepared = decode(source)?;
+    let mut renderer = gpui_platform::current_headless_renderer()
+        .ok_or_else(|| "pinned GPUI headless Metal renderer is unavailable".to_owned())?;
+    let (scene, adaptation) = prepared.build_scene(renderer.sprite_atlas().as_ref())?;
+    let clear = prepared.clear_color();
+    let admitted = renderer
+        .render_scene_to_image_with_clear(&scene, prepared.size(), clear)
+        .map_err(|error| format!("pinned GPUI Metal readback failed: {error:#}"))?
+        .into_raw();
+
+    for _ in 0..warmup_iterations {
+        let (image, _) = renderer
+            .render_scene_to_image_profiled(&scene, prepared.size(), clear)
+            .map_err(|error| format!("pinned GPUI Metal profile failed: {error:#}"))?;
+        if image.into_raw() != admitted {
+            return Err("GPUI renderer profile image changed during warmup".to_owned());
+        }
+    }
+
+    let capacity = usize::try_from(sample_count)
+        .map_err(|_| "GPUI renderer profile sample count exceeds usize".to_owned())?;
+    let mut samples = Vec::with_capacity(capacity);
+    for _ in 0..sample_count {
+        let (image, profile) = renderer
+            .render_scene_to_image_profiled(&scene, prepared.size(), clear)
+            .map_err(|error| format!("pinned GPUI Metal profile failed: {error:#}"))?;
+        if image.into_raw() != admitted {
+            return Err("GPUI renderer profile image changed during measurement".to_owned());
+        }
+        samples.push(profile);
+    }
+
+    let gpu_execution_sample_count = samples
+        .iter()
+        .filter(|sample| sample.gpu_execution_ns.is_some())
+        .count() as u64;
+    let csv = render_profile_samples(&samples)?;
+    publish_sample_output(output_path, csv.as_bytes(), "profile")?;
+    Ok(ProfileReport {
+        identity: prepared.identity,
+        adaptation,
+        warmup_iterations,
+        sample_count,
+        gpu_execution_sample_count,
+    })
+}
+
+fn ensure_new_sample_output(output_path: &Path, kind: &str) -> Result<(), String> {
+    match fs::symlink_metadata(output_path) {
+        Err(error) if error.kind() == ErrorKind::NotFound => Ok(()),
+        Ok(_) => Err(format!(
+            "GPUI renderer {kind} output already exists: {}",
+            output_path.display()
+        )),
+        Err(error) => Err(format!(
+            "cannot inspect GPUI renderer {kind} output {}: {error}",
+            output_path.display()
+        )),
+    }
+}
+
+fn render_profile_samples(samples: &[HeadlessRenderProfile]) -> Result<String, String> {
+    let mut csv = String::with_capacity(samples.len().saturating_mul(192).saturating_add(256));
+    csv.push_str("sample_index,resource_preparation_ns,instance_write_ns,command_buffer_ns,render_encoding_ns,readback_encoding_performed,readback_encoding_ns,commit_ns,completion_wait_ns,gpu_execution_available,gpu_execution_ns,readback_compaction_ns,total_ns\n");
+    for (index, sample) in samples.iter().enumerate() {
+        let readback_encoding = sample
+            .readback_encoding_ns
+            .map(|value| value.to_string())
+            .unwrap_or_default();
+        let gpu_execution = sample
+            .gpu_execution_ns
+            .map(|value| value.to_string())
+            .unwrap_or_default();
+        writeln!(
+            &mut csv,
+            "{index},{},{},{},{},{},{},{},{},{},{},{},{}",
+            sample.resource_preparation_ns,
+            sample.instance_write_ns,
+            sample.command_buffer_ns,
+            sample.render_encoding_ns,
+            sample.readback_encoding_ns.is_some(),
+            readback_encoding,
+            sample.commit_ns,
+            sample.completion_wait_ns,
+            sample.gpu_execution_ns.is_some(),
+            gpu_execution,
+            sample.readback_compaction_ns,
+            sample.total_ns,
+        )
+        .map_err(|error| format!("cannot format GPUI renderer profile sample: {error}"))?;
+    }
+    Ok(csv)
+}
+
+fn publish_sample_output(output: &Path, bytes: &[u8], kind: &str) -> Result<(), String> {
+    let temporary = output.with_file_name(format!(
+        ".alpine-gpui-renderer-{kind}-{}.tmp",
+        std::process::id()
+    ));
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&temporary)
+        .map_err(|error| {
+            format!(
+                "cannot create GPUI renderer {kind} temporary output {}: {error}",
+                temporary.display()
+            )
+        })?;
+    let write_result = file.write_all(bytes).and_then(|()| file.sync_all());
+    drop(file);
+    if let Err(error) = write_result {
+        let _ = fs::remove_file(&temporary);
+        return Err(format!(
+            "cannot persist GPUI renderer {kind} temporary output {}: {error}",
+            temporary.display()
+        ));
+    }
+    if let Err(error) = fs::hard_link(&temporary, output) {
+        let _ = fs::remove_file(&temporary);
+        return Err(format!(
+            "cannot publish GPUI renderer {kind} output {} without replacement: {error}",
+            output.display()
+        ));
+    }
+    fs::remove_file(&temporary).map_err(|error| {
+        format!(
+            "cannot remove GPUI renderer {kind} temporary output {}: {error}",
+            temporary.display()
+        )
+    })
+}
+
+fn validate_benchmark_counts(warmup_iterations: u64, sample_count: u64) -> Result<(), String> {
+    if warmup_iterations > MAX_BENCHMARK_WARMUPS {
+        return Err(format!(
+            "GPUI renderer benchmark warmup count must not exceed {MAX_BENCHMARK_WARMUPS}"
+        ));
+    }
+    if !(1..=MAX_BENCHMARK_SAMPLES).contains(&sample_count) {
+        return Err(format!(
+            "GPUI renderer benchmark sample count must be between 1 and {MAX_BENCHMARK_SAMPLES}"
+        ));
+    }
+    Ok(())
+}
+
+fn elapsed_benchmark_ns(started: std::time::Instant) -> Result<u64, String> {
+    let elapsed = started.elapsed().as_nanos();
+    if elapsed == 0 {
+        return Err(
+            "GPUI renderer benchmark clock resolution produced a zero-duration sample".to_owned(),
+        );
+    }
+    match u64::try_from(elapsed) {
+        Ok(elapsed) => Ok(elapsed),
+        Err(_) => Err("GPUI renderer benchmark duration exceeded u64 nanoseconds".to_owned()),
+    }
+}
+
+fn render_benchmark_samples(samples: &[u64]) -> Result<String, String> {
+    let sample_bytes = match samples.len().checked_mul(32) {
+        Some(bytes) => bytes,
+        None => return Err("GPUI renderer benchmark CSV capacity overflowed".to_owned()),
+    };
+    let capacity = match sample_bytes.checked_add(24) {
+        Some(capacity) => capacity,
+        None => return Err("GPUI renderer benchmark CSV capacity overflowed".to_owned()),
+    };
+    let mut csv = String::with_capacity(capacity);
+    csv.push_str("sample_index,elapsed_ns\n");
+    for (index, elapsed) in samples.iter().enumerate() {
+        if let Err(error) = writeln!(&mut csv, "{index},{elapsed}") {
+            return Err(format!(
+                "cannot format GPUI renderer benchmark sample: {error}"
+            ));
+        }
+    }
+    Ok(csv)
+}
+
+fn publish_benchmark_samples(output: &Path, bytes: &[u8]) -> Result<(), String> {
+    let temporary = output.with_file_name(format!(
+        ".alpine-gpui-renderer-benchmark-{}.tmp",
+        std::process::id()
+    ));
+    let mut file = match OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&temporary)
+    {
+        Ok(file) => file,
+        Err(error) => {
+            return Err(format!(
+                "cannot create GPUI renderer benchmark temporary output {}: {error}",
+                temporary.display()
+            ));
+        }
+    };
+    let write_result = file.write_all(bytes).and_then(|()| file.sync_all());
+    drop(file);
+    if let Err(error) = write_result {
+        let _ = fs::remove_file(&temporary);
+        return Err(format!(
+            "cannot persist GPUI renderer benchmark temporary output {}: {error}",
+            temporary.display()
+        ));
+    }
+    if let Err(error) = fs::hard_link(&temporary, output) {
+        let _ = fs::remove_file(&temporary);
+        return Err(format!(
+            "cannot publish GPUI renderer benchmark output {} without replacement: {error}",
+            output.display()
+        ));
+    }
+    if let Err(error) = fs::remove_file(&temporary) {
+        return Err(format!(
+            "cannot remove GPUI renderer benchmark temporary output {}: {error}",
+            temporary.display()
+        ));
+    }
+    Ok(())
+}
