+        assert!(validate_benchmark_counts(MAX_BENCHMARK_WARMUPS + 1, 1).is_err());
+        assert!(validate_benchmark_counts(0, 0).is_err());
+        assert!(validate_benchmark_counts(0, MAX_BENCHMARK_SAMPLES + 1).is_err());
+
+        let csv = render_benchmark_samples(&[11, 22, 33]).expect("render benchmark samples");
+        assert_eq!(csv, "sample_index,elapsed_ns\n0,11\n1,22\n2,33\n");
+        let output =
+            std::env::temp_dir().join(format!("alpine-gpui-benchmark-{}.csv", std::process::id()));
+        let temporary = output.with_file_name(format!(
+            ".alpine-gpui-renderer-benchmark-{}.tmp",
+            std::process::id()
+        ));
+        let _ = fs::remove_file(&output);
+        let _ = fs::remove_file(&temporary);
+        fs::write(&temporary, b"collision").expect("create temporary collision");
+        assert!(
+            publish_benchmark_samples(&output, csv.as_bytes())
