+
+    fn rebind(source: String) -> String {
+        let canonical = canonical_workload_hash(&source).expect("canonical hash");
+        let mut rebound = String::with_capacity(source.len());
+        for line in source.split_inclusive('\n') {
+            if line.starts_with("workload_hash = ") {
+                rebound.push_str(&format!("workload_hash = \"{canonical}\"\n"));
+            } else {
+                rebound.push_str(line);
+            }
+        }
+        rebound
+    }
+
+    fn rejects(source: &str, expected: &str) {
+        let error = decode(source).err().expect("trace must be rejected");
+        assert!(error.contains(expected), "unexpected error: {error}");
+    }
+}
